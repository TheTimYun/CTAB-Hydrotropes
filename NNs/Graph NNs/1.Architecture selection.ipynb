    "torch.manual_seed(1)\n",
    "for n in range(n_epochs):\n",
    "    total_num_graphs_train = 0\n",
    "    model.train()\n",
    "    model.to(device)\n",
    "    predictions = []\n",
    "    ys = []\n",
    "    for batch in train_dl:\n",
    "        optimizer.zero_grad()\n",
    "        batch.to(device)\n",
    "        output = model(batch)\n",
    "        loss = loss_fn(output, batch.y)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        predictions.append(output)\n",
    "        ys.append(batch.y)\n",
    "    predictions = torch.cat(predictions, dim = 0).cpu().detach()\n",
    "    #probs = torch.softmax(predictions, dim =1)\n",
    "    #threshold = 0.9\n",
    "    #labels = (probs[:,1] > threshold).long()\n",
    "    labels = torch.argmax(predictions, dim =1)\n",
    "    ys = torch.cat(ys).cpu()\n",
    "    acc_train = Accuracy(task  ='binary')\n",
    "    prec_train = Precision(task = 'binary')\n",
    "    rec_train = Recall(task = 'binary')\n",
    "    f1_train = F1Score(task = 'binary')\n",
    "    wandb.log({'train_accuracy':acc_train(labels,ys),\n",
    "               'train_precision':prec_train(labels, ys),\n",
    "               'train_recall':rec_train(labels, ys),\n",
    "               'train_f1':f1_train(labels, ys)})\n",
    "                \n",
    "\n",
    "    \n",
    "    model.eval()\n",
    "    predictions = []\n",
    "    ys = []\n",
    "    for batch in test_dl:\n",
    "        batch.to(device)\n",
    "        output = model(batch)\n",
    "        predictions.append(output)\n",
    "        ys.append(batch.y)\n",
    "        loss = loss_fn(output, batch.y)\n",
    "    predictions = torch.cat(predictions, dim = 0).cpu().detach()\n",
    "    #probs = torch.softmax(predictions, dim =1)\n",
    "    #threshold = 0.9\n",
    "    #labels = (probs[:,1] > threshold).long()\n",
    "    labels = torch.argmax(predictions, dim = 1)\n",
    "    \n",
    "    \n",
    "    ys = torch.cat(ys).cpu()\n",
    "    acc = Accuracy(task  ='binary')\n",
    "    prec = Precision(task = 'binary')\n",
    "    rec = Recall(task = 'binary')\n",
    "    f1 = F1Score(task = 'binary')\n",
    "    wandb.log({'test_accuracy':acc(labels,ys),\n",
    "               'test_precision':prec(labels, ys),\n",
    "               'test_recall':rec(labels, ys),\n",
    "               'test_f1':f1(labels, ys)})\n",
    "    print('Accuracy for epoch {} is {}, precision is {}'.format(n, acc(labels,ys), prec(labels, ys)))"
   ]
