    "class Graph_nn(nn.Module):\n",
    "    def __init__(self, num_node_features = 21):\n",
    "        super().__init__()\n",
    "        self.nn_conv_1 = NNConv(in_channels = num_node_features, out_channels = 500, nn = nn.Sequential(nn.Linear(4, 500), nn.CELU(), nn.Linear(500, 21*500)))\n",
    "        self.nn_conv_2 = NNConv(in_channels = 50, out_channels = 500, nn = nn.Sequential(nn.Linear(4, 50), nn.CELU(), nn.Linear(50, 50*500)))\n",
    "        self.a_nn_conv1 = nn.CELU()\n",
    "        self.a_nn_conv2 = nn.CELU()\n",
    "        #convolutional layers\n",
    "        self.conv_1 = GraphConv(in_channels = 500, out_channels = 500)\n",
    "        self.a1 = nn.CELU()\n",
    "        self.conv_2 = GraphConv(in_channels = 500, out_channels = 500)\n",
    "        self.a2 = nn.CELU()\n",
    "        #edge convolutional layers\n",
    "        self.edge_conv_3 = EdgeConv(nn = nn.Sequential(nn.Linear(1000, 500), nn.CELU(), nn.Linear(500,500)))\n",
    "        self.edge_conv_4 = EdgeConv(nn = nn.Sequential(nn.Linear(1000, 500), nn.CELU(), nn.Linear(500,500)))\n",
    "        self.a3 = nn.CELU()\n",
    "        self.a4 = nn.CELU()\n",
    "        #NNconvolutional \n",
    "        self.dropout_1 = nn.Dropout(p = 0.5)\n",
    "        self.linear_1 = nn.Linear(in_features = 500, out_features = 2)\n",
    "        self.edgepool = EdgePooling(in_channels = 500,  dropout = 0.3) \n",
    "        #self.a3 = nn.CELU()\n",
    "        #self.linear_2 = nn.Linear(in_features = 500, out_features = 500)\n",
    "        #self.a4 = nn.CELU()\n",
    "        #self.linear_3 = nn.Linear(in_features = 500, out_features = 2)\n",
    "        \n",
    "    def forward(self, data):\n",
    "        x, edge_index, edge_attr  = data.x, data.edge_index, data.edge_attr\n",
